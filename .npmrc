# Project-level npm config, committed on purpose.
#
# 1. Pin the registry. Publish and stage must go to npmjs.org; a machine-level
#    mirror setting (npmmirror/taobao and friends) silently wins otherwise, and
#    the failure looks like an auth error rather than a wrong-host error.
registry=https://registry.npmjs.org/

# 2. Let CI authenticate without storing a secret in this file.
#
#    ${NPM_TOKEN} is expanded by npm from the environment when the file is read,
#    so what is committed here is a reference, never the token itself. In
#    .github/workflows/publish.yml the value comes from the repository secret of
#    the same name; locally it is usually unset, which just means an empty token
#    — reads from the public registry still work, writes do not.
#
#    Do not paste a literal token on this line. It would end up in git history,
#    and rotating it would mean rewriting history instead of editing a secret.
//registry.npmjs.org/:_authToken=${NPM_TOKEN}

# 3. Keep install output honest in CI.
fund=false
audit=false
