{
  "name": "herdr-dingtalk-omo-bridge",
  "version": "0.3.0",
  "description": "Herdr plugin that bridges DingTalk messages to an OmO coding-agent session, posts the answer back, and tags each message as received/done.",
  "keywords": [
    "herdr",
    "dingtalk",
    "omo",
    "agent",
    "bridge",
    "plugin"
  ],
  "license": "MIT",
  "bin": {
    "herdr-dingtalk-omo-bridge": "bin/herdr-dingtalk-omo-bridge.mjs"
  },
  "files": [
    "bin/",
    "installer.mjs",
    "herdr-plugin.toml",
    "agent-target.mjs",
    "attachments.mjs",
    "auth.mjs",
    "check-reply.mjs",
    "dingtalk-bridge.mjs",
    "herdr-paths.mjs",
    "image-out.mjs",
    "inbound.mjs",
    "probe.mjs",
    "probe-emotion.mjs",
    "probe-image.mjs",
    "process-state.mjs",
    "session-log.mjs",
    "slash.mjs",
    "startup.mjs",
    "supervise.mjs",
    "npm-shrinkwrap.json",
    "docs/herdr-notes.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CurrenWong/herdr-dingtalk-omo-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/CurrenWong/herdr-dingtalk-omo-bridge/issues"
  },
  "homepage": "https://github.com/CurrenWong/herdr-dingtalk-omo-bridge#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node .github/scripts/check-syntax.mjs",
    "check-messages": "node .github/scripts/check-messages.mjs",
    "check-paths": "node .github/scripts/check-paths.mjs",
    "check-manifest": "node .github/scripts/check-manifest.mjs",
    "scan-secrets": "node .github/scripts/scan-secrets.mjs .",
    "check-reply": "node check-reply.mjs",
    "probe-emotion": "node probe-emotion.mjs",
    "probe-image": "node probe-image.mjs"
  },
  "dependencies": {
    "dingtalk-stream": "^2.1.6-beta.1"
  }
}
